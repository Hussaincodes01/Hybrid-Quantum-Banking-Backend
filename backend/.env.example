# Database
PGHOST=localhost
PGPORT=5432
PGDATABASE=finix
PGUSER=finix
PGPASSWORD=changeme
PGSSLMODE=disable

# Groq LLM
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192

# ONNX Models
FINIX_RISK_MODEL_PATH=models/security/fraud_label/v1/model.onnx

# Server
APP_ADDR=0.0.0.0:8080

# ── Mandatory security secrets ───────────────────────────────────────────
# The server REFUSES to start without these (no insecure fallbacks — C-7/C-8).
# Generate strong random values; never reuse across environments; rotate any
# secret that was ever committed to version control (H-12).
FINIX_JWT_SECRET=            # >= 16 chars, strong random — signs short-lived JWTs
FINIX_DATA_ENCRYPTION_KEY=   # AES-256 key for PII at rest; no hostname-derived fallback
FINIX_AADHAAR_HASH_KEY=      # dedicated HMAC pepper for Aadhaar UID hashing

# ── Optional hardening ───────────────────────────────────────────────────
CERT_PINS=                   # comma-separated SHA-256 cert fingerprints
CORS_ALLOWED_ORIGINS=        # explicit allow-list; credentials only for exact matches

# ── Post-quantum security ────────────────────────────────────────────────
# The REAL PQC for the Android<->backend link is TLS-layer hybrid key
# exchange (X25519MLKEM768), negotiated automatically by TLS 1.3 when the
# edge is served over HTTPS via Caddy (see deploy/Caddyfile). No app config
# needed — verified with Go's crypto/tls default groups.
#
# FINIX_REQUIRE_PQC additionally gates authenticated /v1 routes on a valid
# X-PQC-Session (application-layer Kyber-1024 KEM handshake). EXPERIMENTAL:
# leave false until clients ship a vetted, interoperable ML-KEM library — the
# current Flutter Kyber is not interoperable, so enabling this would lock out
# the app. Values: true/1/yes/on.
FINIX_REQUIRE_PQC=false
