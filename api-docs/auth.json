{
  "module": "Authentication & Onboarding",
  "base_path": "/v1/auth",
  "endpoints": [
    {
      "id": "register",
      "method": "POST",
      "path": "/v1/auth/register",
      "auth_required": false,
      "rate_limit": "10/min",
      "description": "Register a new user. Returns userId and UBT token.",
      "request": {
        "body": {
          "name": "string (optional, defaults to 'FINIX User')",
          "mobile": "string (required, validated format)",
          "email": "string (optional, validated format)",
          "deviceIdFingerprint": "string (required)",
          "deviceType": "string (optional, e.g. 'android', 'ios')",
          "appVersion": "string (optional, e.g. '0.1.0')",
          "ipAddress": "string (optional)",
          "pin": "string (optional, 4+ digits)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "userId": "usr_<uuid>",
          "ubt": "ubt_<hex>"
        }
      },
      "errors": [
        {"status": 400, "message": "mobile number is required"},
        {"status": 400, "message": "device fingerprint is required"}
      ],
      "flutter_hint": "Call on app launch after collecting device info. Store userId and ubt for subsequent calls."
    },
    {
      "id": "ekyc_verify",
      "method": "POST",
      "path": "/v1/auth/ekyc/verify",
      "auth_required": false,
      "rate_limit": "20/min",
      "description": "Verify eKYC with PAN and Aadhaar last 4 digits.",
      "request": {
        "body": {
          "userId": "string (required)",
          "panLast4": "string (required, 4 chars)",
          "aadhaarLast4": "string (required, 4 chars)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "usr_<uuid>",
          "name": "string",
          "mobile": "string",
          "email": "string",
          "ubt": "string",
          "ekycVerified": true,
          "biometricEnabled": false,
          "deviceBound": true,
          "simBound": true,
          "createdAt": "2026-01-01T00:00:00Z"
        }
      },
      "flutter_hint": "After registration, collect last 4 of PAN and Aadhaar. Show user the KIN returned."
    },
    {
      "id": "biometric_register",
      "method": "POST",
      "path": "/v1/auth/biometric/register",
      "auth_required": false,
      "rate_limit": "20/min",
      "description": "Register device biometric key (WebAuthn/Passkey public key).",
      "request": {
        "body": {
          "userId": "string (required)",
          "publicKeyB64": "string (required, base64 encoded public key)",
          "keyId": "string (optional, auto-generated if empty)",
          "deviceName": "string (optional)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "usr_<uuid>",
          "biometricEnabled": true
        }
      },
      "flutter_hint": "Use local_auth or flutter_webauthn to generate key pair, send public key here."
    },
    {
      "id": "login_challenge",
      "method": "POST",
      "path": "/v1/auth/login/challenge",
      "auth_required": false,
      "rate_limit": "20/min",
      "description": "Create a login challenge for biometric auth.",
      "request": {
        "body": {
          "userId": "string (required)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "challengeId": "string",
          "challenge": "string (base64 encoded challenge bytes)"
        }
      },
      "flutter_hint": "Get challenge, sign it with device private key using local biometric prompt, then call login/verify."
    },
    {
      "id": "login_verify",
      "method": "POST",
      "path": "/v1/auth/login/verify",
      "auth_required": false,
      "rate_limit": "20/min",
      "description": "Verify biometric signature and get access token.",
      "request": {
        "body": {
          "userId": "string (required)",
          "challengeId": "string (required)",
          "signature": "string (required, base64 encoded signature)",
          "keyId": "string (required)",
          "deviceIdFingerprint": "string (required)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "accessToken": "swt_<hex>",
          "expiresInSeconds": 900
        }
      },
      "errors": [
        {"status": 401, "message": "biometric signature verification failed"},
        {"status": 401, "message": "login restricted: device binding mismatch"}
      ],
      "flutter_hint": "Store accessToken securely (flutter_secure_storage). Set as Bearer token for all /v1/* calls."
    },
    {
      "id": "pin_set",
      "method": "POST",
      "path": "/v1/auth/login/pin/set",
      "auth_required": true,
      "rate_limit": "20/min",
      "description": "Set a 4+ digit PIN for quick login.",
      "request": {
        "body": {
          "pin": "string (required, 4+ digits)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": "pin_set"
        }
      },
      "flutter_hint": "Call after first login to enable PIN-based quick login."
    },
    {
      "id": "pin_login",
      "method": "POST",
      "path": "/v1/auth/login/pin",
      "auth_required": false,
      "rate_limit": "20/min",
      "description": "Login with PIN (simpler than biometric flow).",
      "request": {
        "body": {
          "userId": "string (required)",
          "pin": "string (required)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "accessToken": "swt_<hex>",
          "expiresInSeconds": 900
        }
      },
      "flutter_hint": "Alternative to biometric login. Use if biometric not available."
    },
    {
      "id": "sim_bind",
      "method": "POST",
      "path": "/v1/auth/sim-bind",
      "auth_required": false,
      "rate_limit": "20/min",
      "description": "Bind SIM card to device for additional security.",
      "request": {
        "body": {
          "mobile": "string (required)",
          "device_id": "string (required)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ubt_token": "ubt_<hex>",
          "status": "active"
        }
      }
    },
    {
      "id": "stepup_challenge",
      "method": "POST",
      "path": "/v1/auth/stepup/challenge",
      "auth_required": true,
      "rate_limit": "20/min",
      "description": "Create step-up authentication challenge for sensitive operations.",
      "request": {
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "challengeId": "string",
          "challenge": "string (base64)"
        }
      },
      "flutter_hint": "Use before high-value transactions or settings changes."
    },
    {
      "id": "otp_generate",
      "method": "POST",
      "path": "/v1/auth/otp/generate",
      "auth_required": true,
      "rate_limit": "20/min",
      "description": "Generate OTP for step-up verification. In demo mode, returns OTP in response.",
      "request": {
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "status": "generated",
          "otp": "123456",
          "note": "In production, OTP is sent via SMS."
        }
      },
      "flutter_hint": "Demo returns OTP directly. Production will send via SMS."
    },
    {
      "id": "oauth_token",
      "method": "POST",
      "path": "/v1/oauth/token",
      "auth_required": false,
      "rate_limit": "20/min",
      "description": "Exchange OAuth authorization code for token.",
      "request": {
        "body": {
          "grant_type": "string (required)",
          "code": "string (required)",
          "code_verifier": "string (optional)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "access_token": "string",
          "token_type": "Bearer",
          "expires_in": 900
        }
      }
    },
    {
      "id": "oauth_authorize",
      "method": "POST",
      "path": "/v1/oauth/authorize",
      "auth_required": true,
      "rate_limit": "20/min",
      "description": "Generate OAuth authorization code.",
      "request": {
        "body": {
          "code_challenge": "string (optional, PKCE)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "authorization_code": "string",
          "expires_in": "300"
        }
      }
    },
    {
      "id": "profile_get",
      "method": "GET",
      "path": "/v1/auth/profile",
      "auth_required": true,
      "description": "Get authenticated user profile (sanitized).",
      "response": {
        "status": 200,
        "body_ref": "AuthProfile (sanitized)"
      }
    },
    {
      "id": "profile_update",
      "method": "PATCH",
      "path": "/v1/auth/profile",
      "auth_required": true,
      "description": "Update user profile.",
      "request": {
        "body": "UpdateAuthProfileRequest"
      },
      "response": {
        "status": 200,
        "body": "AuthProfile"
      }
    },
    {
      "id": "kyc_profile_get",
      "method": "GET",
      "path": "/v1/kyc/profile",
      "auth_required": true,
      "description": "Get KYC profile (sanitized).",
      "response": {
        "status": 200,
        "body_ref": "KYCProfile (sanitized)"
      }
    },
    {
      "id": "kyc_profile_upsert",
      "method": "PATCH",
      "path": "/v1/kyc/profile",
      "auth_required": true,
      "description": "Create or update KYC profile.",
      "request": {
        "body": "UpsertKYCProfileRequest"
      },
      "response": {
        "status": 200,
        "body": "KYCProfile"
      }
    },
    {
      "id": "auth_kin",
      "method": "GET",
      "path": "/v1/auth/kin",
      "auth_required": true,
      "description": "Get user's KIN (Know Your Customer Identification Number).",
      "response": {
        "status": 200,
        "body": {
          "kin": "string",
          "user_id": "string"
        }
      }
    },
    {
      "id": "pqc_init",
      "method": "GET",
      "path": "/v1/auth/pqc/init",
      "auth_required": false,
      "description": "Initialize post-quantum key exchange (Kyber-1024).",
      "response": {
        "status": 200,
        "body": {
          "publicKey": "string (base64)",
          "algorithm": "Kyber-1024",
          "keyId": "string",
          "keyInfo": "object",
          "sessionTTL": 300
        }
      }
    },
    {
      "id": "pqc_encapsulate",
      "method": "POST",
      "path": "/v1/auth/pqc/encapsulate",
      "auth_required": false,
      "description": "Encapsulate shared secret for PQC session.",
      "request": {
        "body": {
          "ciphertext": "string (base64)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": "success",
          "sessionId": "string",
          "expiresIn": 300,
          "message": "Use X-PQC-Session header with this sessionId"
        }
      }
    },
    {
      "id": "pqc_key_info",
      "method": "GET",
      "path": "/v1/auth/pqc/key-info",
      "auth_required": false,
      "description": "Get current PQC key information.",
      "response": {
        "status": 200,
        "body": "PQCKeyInfo"
      }
    },
    {
      "id": "dilithium_public_key",
      "method": "GET",
      "path": "/v1/auth/dilithium/public-key",
      "auth_required": false,
      "description": "Get Dilithium signature public key.",
      "response": {
        "status": 200,
        "body": {
          "publicKey": "string (base64)",
          "algorithm": "string",
          "keyId": "string",
          "keyInfo": "object"
        }
      }
    }
  ]
}
