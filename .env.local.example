# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Groq API key: powers the backend chatbot AND the finix-rag LLM.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Leave blank to have the launcher generate strong random values per run.
# Pin them only if sessions must survive a restart.
FINIX_JWT_SECRET=
FINIX_DATA_ENCRYPTION_KEY=
FINIX_AADHAAR_HASH_KEY=
FINIX_INTERNAL_TOKEN=
FINIX_ADMIN_TOKEN=
