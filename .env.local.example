# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Groq API key: powers the backend chatbot AND the finix-rag LLM.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Leave blank to have the launcher generate strong random values per run.
# Pin them only if sessions must survive a restart.
FINIX_JWT_SECRET=
FINIX_DATA_ENCRYPTION_KEY=
FINIX_AADHAAR_HASH_KEY=
# Shared by the backend AND finix-rag: the backend authenticates to the RAG
# bridge with this exact value, so pin it (do not leave blank) when running RAG.
FINIX_INTERNAL_TOKEN=
FINIX_ADMIN_TOKEN=

# ── finix-rag only ────────────────────────────────────────────────────
# Qdrant must be reachable. Start it with:
#   docker run -d --name finix-qdrant -p 6333:6333 qdrant/qdrant
# llama-index's QdrantVectorStore demands a non-empty api_key alongside a url,
# even though a local Qdrant runs without auth.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=local-dev
