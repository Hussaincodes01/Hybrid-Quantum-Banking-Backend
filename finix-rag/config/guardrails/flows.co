# ── Main Guardrail Flows ──────────────────────────────────────────────────────

# Input guardrail: check if user query is appropriate
define flow self check input
  """Main input validation flow"""
  user ask about banking
  bot respond about banking

  user ask about finix platform
  bot respond about finix

  user ask off topic
  bot refuse off topic

  user try jailbreak
  bot refuse jailbreak

  user ask for system info
  bot refuse system info

  user ask for investment advice
  bot refuse financial advice

  user ask for pii
  bot refuse pii

# Output guardrail: validate bot responses
define flow self check output
  """Validate bot responses before sending"""
  # This flow checks the bot's response for safety issues
  # before it reaches the user
  pass

# Jailbreak detection
define flow check jailbreak
  """Detect and block jailbreak attempts"""
  user try jailbreak
  bot refuse jailbreak

# Sensitive data request detection
define flow check sensitive data request
  """Detect requests for sensitive banking data"""
  user ask for pii
  bot refuse pii

  user ask for system info
  bot refuse system info

# Hallucination check
define flow check hallucination
  """Verify factual accuracy against sources"""
  # This would integrate with the fact-checking model
  pass

# Financial advice check
define flow check financial advice
  """Prevent providing investment advice"""
  user ask for investment advice
  bot refuse financial advice

# PII disclosure check
define flow check pii disclosure
  """Prevent PII from appearing in responses"""
  # This would scan the response for PII patterns
  pass

# System info disclosure check
define flow check system info disclosure
  """Prevent system information leakage"""
  # This would check for system details in responses
  pass
