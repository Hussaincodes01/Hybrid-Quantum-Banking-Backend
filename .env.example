# =============================================================================
# FINIX PRODUCTION - COMPLETE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in all REQUIRED values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL SETTINGS
# -----------------------------------------------------------------------------
FINIX_ENV=production                    # development|staging|production
LOG_LEVEL=info                          # debug|info|warn|error
LOG_FORMAT=json                         # json|text

# -----------------------------------------------------------------------------
# SERVER SETTINGS (Go Backend)
# -----------------------------------------------------------------------------
SERVER_ADDR=:8080                       # HTTP listen address
SERVER_READ_TIMEOUT=30s                 # Read timeout
SERVER_WRITE_TIMEOUT=30s                # Write timeout
SERVER_IDLE_TIMEOUT=120s                # Idle timeout
SERVER_SHUTDOWN_TIMEOUT=30s             # Graceful shutdown timeout

# -----------------------------------------------------------------------------
# POSTGRESQL DATABASE (Required for production)
# -----------------------------------------------------------------------------
PGHOST=localhost                        # Database host
PGPORT=5432                             # Database port
PGDATABASE=finix                        # Database name
PGUSER=finix                            # Database user
PGPASSWORD=                             # REQUIRED: Database password (min 16 chars)
PGSSLMODE=disable                       # disable|require|verify-ca|verify-full
PG_MAX_CONNS=25                         # Max connection pool size
FINIX_MIGRATIONS_DIR=migrations         # Migration files directory

# -----------------------------------------------------------------------------
# REDIS (Required for: Rate Limiting, Outbox, Session, JWT Revocation)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379        # Redis connection URL
REDIS_PASSWORD=                         # Optional: Redis password
REDIS_DB=0                              # Redis database number

# -----------------------------------------------------------------------------
# QDRANT VECTOR DATABASE (Required for RAG)
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost                   # Qdrant host
QDRANT_PORT=6333                        # Qdrant HTTP port
QDRANT_GRPC_PORT=6334                   # Qdrant gRPC port
QDRANT_API_KEY=                         # Optional: Qdrant API key
QDRANT_COLLECTION=finix_documents       # Collection name

# -----------------------------------------------------------------------------
# VAULT SECRETS MANAGEMENT (Required for PII encryption)
# -----------------------------------------------------------------------------
VAULT_ADDR=http://localhost:8200        # Vault address
VAULT_TOKEN=                            # REQUIRED: Vault token
VAULT_NAMESPACE=                        # Optional: Vault namespace

# -----------------------------------------------------------------------------
# OPA (Open Policy Agent) - Authorization
# -----------------------------------------------------------------------------
OPA_URL=http://localhost:8181           # OPA server URL

# -----------------------------------------------------------------------------
# HYPERLEDGER FABRIC (Optional - for immutable ledger)
# -----------------------------------------------------------------------------
FABRIC_ENABLED=false                    # true|false
FABRIC_PEER_ENDPOINT=localhost:7051     # Peer endpoint
FABRIC_PEER_TLS_ENABLED=true            # true|false
FABRIC_CA_URL=                                 # Fabric CA URL
FABRIC_CHANNEL=finix-channel            # Channel name
FABRIC_CHAINCODE=finix                  # Chaincode name
FABRIC_MSP_ID=FinixMSP                  # MSP ID
FABRIC_CERT_PATH=                       # Path to certificates
FABRIC_KEY_PATH=                        # Path to private key

# -----------------------------------------------------------------------------
# SECURITY - CRITICAL (All REQUIRED for production)
# -----------------------------------------------------------------------------

# JWT Secret - HS256 signing key (MIN 32 chars, recommend 64+)
# Generate with: openssl rand -base64 48
FINIX_JWT_SECRET=                       # REQUIRED

# Internal service-to-service token (for Go ↔ Python RAG communication)
# Generate with: openssl rand -base64 32
FINIX_INTERNAL_TOKEN=                   # REQUIRED

# Aadhaar hashing key (for PII protection)
# Generate with: openssl rand -base64 32
FINIX_AADHAAR_HASH_KEY=                 # REQUIRED

# Data encryption key (for Vault transit / field encryption)
# Generate with: openssl rand -base64 32
FINIX_DATA_ENCRYPTION_KEY=              # REQUIRED

# Certificate pinning (SHA256 fingerprints, comma-separated)
# Get with: openssl x509 -in cert.pem -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
CERT_PINS=                              # REQUIRED for production (comma-separated)

# Enforce certificate pinning (true for production)
FINIX_PIN_ENFORCE=true                  # true|false

# Require Post-Quantum Cryptography sessions
FINIX_REQUIRE_PQC=false                 # true|false (requires Kyber-1024 support)

# JWT Revocation fail-closed (true = deny on lookup failure)
FINIX_REVOCATION_FAIL_CLOSED=true       # true|false (true for production)

# -----------------------------------------------------------------------------
# GROQ LLM (Required for chatbot and RAG synthesis)
# -----------------------------------------------------------------------------
GROQ_API_KEY=                           # REQUIRED: Get from console.groq.com
GROQ_MODEL=llama-3.1-8b-instant         # Model: llama-3.1-8b-instant|llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# AI/RAG CONFIGURATION
# -----------------------------------------------------------------------------
AI_PROVIDER=remote                      # local|remote (remote = Python RAG service)
AIML_UPSTREAM_URL=http://localhost:8000 # Python RAG service URL
FINIX_INTERNAL_TOKEN=                   # Same as above (for RAG client)
RAG_PG_DSN=postgres://finix:PASSWORD@localhost:5432/finix?sslmode=disable  # Read replica for RAG

# -----------------------------------------------------------------------------
# EMBEDDING MODEL CONFIGURATION (Python RAG)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3             # Embedding model
EMBEDDING_DEVICE=cpu                    # cpu|cuda
EMBEDDING_BATCH_SIZE=32                 # Batch size for embeddings
EMBEDDING_NORMALIZE=true                # Normalize embeddings

# -----------------------------------------------------------------------------
# RERANKER CONFIGURATION (Python RAG)
# -----------------------------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # Reranker model
RERANKER_DEVICE=cpu                     # cpu|cuda
RERANKER_SCORE_THRESHOLD=0.10           # Minimum relevance score
RERANKER_TOP_K=5                        # Top K after reranking
RERANKER_FP16=false                     # Use FP16 (cuda only)

# -----------------------------------------------------------------------------
# PYTHON RAG SERVICE SPECIFIC
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080  # Comma-separated
ENABLE_PII_MASKING=true                 # true|false
UPLOAD_DIR=/app/uploads                 # Document upload directory
QDRANT_API_KEY=                         # Optional: Qdrant API key

# -----------------------------------------------------------------------------
# BANK INTEGRATION (Provider Seam Pattern)
# -----------------------------------------------------------------------------
BANK_PROVIDER=mock                      # mock|razorpay
RAZORPAY_KEY_ID=                        # Required if BANK_PROVIDER=razorpay
RAZORPAY_KEY_SECRET=                    # Required if BANK_PROVIDER=razorpay

# -----------------------------------------------------------------------------
# KYC INTEGRATION
# -----------------------------------------------------------------------------
KYC_PROVIDER=mock                       # mock|nsdl
NSDL_API_KEY=                           # Required if KYC_PROVIDER=nsdl
NSDL_API_SECRET=                        # Required if KYC_PROVIDER=nsdl

# -----------------------------------------------------------------------------
# SIM BINDING INTEGRATION
# -----------------------------------------------------------------------------
SIM_PROVIDER=mock                       # mock|telecom
TELECOM_API_KEY=                        # Required if SIM_PROVIDER=telecom
TELECOM_API_SECRET=                     # Required if SIM_PROVIDER=telecom

# -----------------------------------------------------------------------------
# PROMETHEUS / GRAFANA (Monitoring)
# -----------------------------------------------------------------------------
PROMETHEUS_RETENTION=30d                # Metrics retention
GRAFANA_ADMIN_USER=admin                # Grafana admin user
GRAFANA_ADMIN_PASSWORD=admin            # Grafana admin password (CHANGE!)

# -----------------------------------------------------------------------------
# DOCKER COMPOSE OVERRIDES (for local development)
# -----------------------------------------------------------------------------
# These are used by docker-compose.yml
POSTGRES_PASSWORD=${PGPASSWORD}
REDIS_PASSWORD=${REDIS_PASSWORD}
VAULT_TOKEN=${VAULT_TOKEN}
QDRANT_API_KEY=${QDRANT_API_KEY}

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_OUTBOX_WORKER=true               # true|false
ENABLE_FRAUD_GRAPH=true                 # true|false
ENABLE_PQC=true                         # true|false
ENABLE_DILITHIUM=true                   # true|false
ENABLE_BIOMETRIC=true                   # true|false
ENABLE_MONTE_CARLO=true                 # true|false

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL=240                   # requests per minute per IP
RATE_LIMIT_AUTH=20                      # requests per minute per IP
RATE_LIMIT_REGISTER=10                  # requests per minute per IP

# -----------------------------------------------------------------------------
# DEVELOPMENT OVERRIDES (Only for local development)
# -----------------------------------------------------------------------------
# DEV_MODE=true                         # Uncomment for development
# PGSSLMODE=disable                     # Already default
# FINIX_REVOCATION_FAIL_CLOSED=false    # Fail-open for dev
# FINIX_PIN_ENFORCE=false               # Disable cert pinning for dev
# CERT_PINS=                            # Empty for dev
# AI_PROVIDER=local                     # Use in-process chatbot
# BANK_PROVIDER=mock                    # Use mock bank
# KYC_PROVIDER=mock                     # Use mock KYC
# SIM_PROVIDER=mock                     # Use mock SIM